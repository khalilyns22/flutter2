{
  "entities": {
    "Course": {
      "title": "Course",
      "description": "Represents an academic course or subject taught by a teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 32 },
        "section": { "type": "string", "maxLength": 32 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "schedule": { "type": "string", "maxLength": 100 },
        "totalEnrolled": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "code", "teacherId"]
    },
    "Student": {
      "title": "Student",
      "description": "Represents an enrolled student in a course.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 150 },
        "rollNumber": { "type": "string", "maxLength": 50 },
        "courseId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "rollNumber", "courseId"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "A live or completed classroom attendance session generated by a teacher.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "currentQrToken": { "type": "string", "maxLength": 256 },
        "tokenExpiresAt": { "type": "number" },
        "sessionPin": { "type": "string", "maxLength": 10 },
        "presentCount": { "type": "number" },
        "absentCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "courseId", "teacherId", "date", "status"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual student attendance entry logged via QR code scan or manual teacher override.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "courseId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 150 },
        "studentRollNumber": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["present", "late", "absent", "excused"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string", "enum": ["qr_scan", "manual", "pin"] },
        "notes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "sessionId", "courseId", "studentId", "status"]
    }
  },
  "firestore": {
    "/courses/{courseId}": {
      "schema": { "$ref": "#/entities/Course" },
      "description": "Courses managed by teachers."
    },
    "/courses/{courseId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students enrolled in a specific course."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/AttendanceSession" },
      "description": "Live attendance sessions with dynamic QR tokens."
    },
    "/sessions/{sessionId}/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Real-time student check-in records for a session."
    }
  }
}
