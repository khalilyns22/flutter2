rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Course Validation
    function isValidCourse(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 32 &&
             data.teacherId is string && data.teacherId.size() <= 128;
    }

    match /courses/{courseId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(courseId) && isValidCourse(incoming()) && incoming().teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(courseId) && isValidCourse(incoming()) && existing().teacherId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(courseId) && existing().teacherId == request.auth.uid;

      match /students/{studentId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn() && isValidId(studentId);
      }
    }

    // Session Validation
    function isValidAttendanceSession(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.courseId is string && data.courseId.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() <= 128 &&
             data.status in ['active', 'closed'];
    }

    match /sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(sessionId) && isValidAttendanceSession(incoming()) && incoming().teacherId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(sessionId) && isValidAttendanceSession(incoming()) && existing().teacherId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(sessionId) && existing().teacherId == request.auth.uid;

      match /attendance/{attendanceId} {
        // Teachers can view and manage all attendance records; students can create their own scan record
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(attendanceId) &&
                         incoming().status in ['present', 'late', 'absent', 'excused'] &&
                         incoming().sessionId == sessionId;
        allow update: if isSignedIn() && isValidId(attendanceId) &&
                         incoming().status in ['present', 'late', 'absent', 'excused'];
        allow delete: if isSignedIn() && isValidId(attendanceId);
      }
    }
  }
}
